# =====================================================================
# Travel Disruption Recovery Engine — Environment Variables Template
# Copy this file to .env and insert your API credentials.
# NEVER commit the active .env file to git or public repositories.
# =====================================================================

# RapidAPI Credentials (Indian Railway IRCTC & AeroDataBox Flights)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST_TRAIN=indian-railway-irctc.p.rapidapi.com
RAPIDAPI_HOST_FLIGHT=aerodatabox.p.rapidapi.com
RAPIDAPI_HOST_WEATHER=weather-api167.p.rapidapi.com
RAPIDAPI_HOST_AI=chatgpt-ai-chat-bot.p.rapidapi.com

# Flight API (Aviationstack fallback / direct)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Bus API (AOPAY Bus Booking India)
AOPAY_BUS_API_KEY=your_aopay_bus_api_key_here

# Google Gemini Generative AI Key
GEMINI_API_KEY=your_gemini_api_key_here

# Mode Settings
DEMO_MODE=true
HOST=127.0.0.1
PORT=8000
